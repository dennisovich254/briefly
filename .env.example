# Environment variables Briefly reads. Names only: copy to .env (git-ignored) for development
# and fill in values there. Credentials belong in the OS keyring (architecture §14.3); .env is
# for development only. scripts/check_governance.sh fails when the app reads a variable that is
# not listed here, or when this file holds a value.

# Lets tests freeze and advance core/clock.jac. scripts/test.sh sets it; leave it unset otherwise,
# so shipped code cannot move time.
BRIEFLY_CLOCK_CONTROL=

# The frozen time while clock control is on, in ISO 8601. Set by core/clock.jac's freeze() in tests
# (the environment reaches every copy of the module, JD-025); ignored unless BRIEFLY_CLOCK_CONTROL=1.
BRIEFLY_CLOCK_FROZEN_AT=

# Claude API key, for development only (byLLM reads it; installed apps keep credentials in the OS
# keyring, architecture §14.3). Tests never use it: they run on MockLLM.
ANTHROPIC_API_KEY=

# The phone link (core/phone/link.jac, architecture §5.6). The laptop's LAN address for the phone;
# found from the default route when unset.
BRIEFLY_PHONE_HOST=

# The phone gate's port (default 47913; 0 picks a free one).
BRIEFLY_PHONE_PORT=

# How long a pairing code stays valid, in seconds (default 120).
BRIEFLY_PHONE_PAIR_TTL_SECONDS=

# The LAN listener: "gate" (default; core/phone/gate.jac, JD-035) or "jac" (no gate; the Jac server
# must listen on the LAN itself), kept to re-test the Jac way.
BRIEFLY_PHONE_LISTENER=

# The XDG base directory for data (not Briefly's own variable): the phone link's self-signed
# certificate lives in $XDG_DATA_HOME/briefly/phone-tls (default ~/.local/share).
XDG_DATA_HOME=

# Cloud speech-to-text keys, for development only (core/stt/cloud.jac; installed apps keep them in the
# OS keyring, architecture §14.3). Tests never use them: they run against fake services.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
