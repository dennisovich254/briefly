# Environment variables Briefly reads. Names only: copy to .env (git-ignored) for development
# and fill in values there. Credentials belong in the OS keyring (architecture §14.3); .env is
# for development only. scripts/check_governance.sh fails when the app reads a variable that is
# not listed here, or when this file holds a value.

# Lets tests freeze and advance core/clock.jac. scripts/test.sh sets it; leave it unset otherwise,
# so shipped code cannot move time.
BRIEFLY_CLOCK_CONTROL=
